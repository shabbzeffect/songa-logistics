# — Songa Logistics env template. Copy to .env.local for local dev. Never commit secrets. —
# Database: embedded PGlite (real Postgres engine) is the default — no DATABASE_URL needed.
# Point at a hosted Postgres (Neon/Supabase/RDS) in production via drizzle-kit using drizzle/schema.ts + drizzle/*.sql.
# DATABASE_URL=postgres://user:pass@host:5432/songa

# Cookie sessions (demo HMAC). Set a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Support contacts shown in the app footer + /support (optional)
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_SUPPORT_PHONE=+254700000000

# — SMS status updates (Africa's Talking). Sandbox first: username "sandbox". —
# Until SMS_ENABLED=true with all fields, order/parcel/rider notifications are
# skipped silently (logged, never fatal) and no audit noise is written.
SMS_ENABLED=false
SMS_API_KEY=
SMS_USERNAME=sandbox
SMS_SENDER=SONGA

# — Online M-Pesa (Daraja STK push). Sandbox first, production at go-live. —
# With MPESA_ENABLED=true + all fields, checkout sends a real STK prompt and
# marks payment on the verified callback. Sandbox creds come from
# https://developer.safaricom.co.ke (create an app, then a sandbox shortcode).
MPESA_ENABLED=false
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/mpesa-callback
